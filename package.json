{
  "name": "ai-harness",
  "version": "0.0.0",
  "private": true,
  "description": "A readable mirror of DeepSeek Harness (DSH) for learners.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' build",
    "typecheck": "pnpm -r --filter='./packages/*' --filter='./apps/*' typecheck",
    "clean": "pnpm -r --filter='./packages/*' --filter='./apps/*' clean",
    "aih": "node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}